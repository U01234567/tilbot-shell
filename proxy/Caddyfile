# Three sites. docs/architecture.md explains this file line by line.
# SHELL_HOST and BOT_HOST come from .env. Names ending in .localhost need no DNS.

# Tilbot's two servers: its API, websocket and project files, and its pages.
(tilbot) {
	@backend path /api/* /ws/* /proj_pub/*
	route {
		reverse_proxy @backend tilbot-backend:8000
		reverse_proxy tilbot-frontend:3000
	}
}

# The shell: sign-up, sign-in and the chat page.
{$SHELL_HOST} {
	encode gzip
	header {
		Content-Security-Policy "default-src 'self'; frame-src https://{$BOT_HOST}; frame-ancestors 'none'; form-action 'self'; base-uri 'self'; object-src 'none'"
		Strict-Transport-Security "max-age={$HSTS_MAX_AGE}"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
	}

	# Tilbot calls /bridge/ inside the Docker network; from outside it does not exist.
	handle /bridge/* {
		respond 404
	}
	handle /static/* {
		uri strip_prefix /static
		root * /srv/static
		file_server
	}
	handle {
		reverse_proxy shell:8000
	}
}

# Tilbot's chat. Only the shell may show it in a frame, and only what participants need is public.
{$BOT_HOST} {
	encode gzip
	header Content-Security-Policy "frame-ancestors https://{$SHELL_HOST}"

	@public path / /_app/* /favicon.png /images/* /proj_pub/* /api/create_conversation /ws/chat
	handle @public {
		import tilbot
	}
	handle {
		respond 404
	}
}

# Tilbot's researcher dashboard: edit, import and export projects, start and stop them.
# Plain HTTP on port 8081, published to 127.0.0.1 by compose.dev.yaml only.
:8081 {
	import tilbot
}
