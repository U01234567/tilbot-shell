# `python start_shell.py up` copies this file to .env and fills in every empty secret. Never commit .env.

SHELL_ENV=development        # development or production
SHELL_HOST=localhost         # where participants open the shell
BOT_HOST=bot.localhost       # where the Tilbot chat is served (inside an iframe)
# INTENT_MODEL=                # sentence-transformers model for phase 3; default: a Dutch one (compose.yaml)

DJANGO_SECRET_KEY=
BRIDGE_SECRET=               # Tilbot adds it to every call to the shell (patches 0001, 0002); nobody types it
TILBOT_SESSION_SECRET=
TILBOT_ADMIN_PASSWORD=       # Tilbot's admin, used by `start_shell.py researcher`; nobody needs to log in with it

# Without this key the stored answers cannot be read. Back it up apart from the database
# (docs/operations.md). Never change it once real data is stored.
FIELD_ENCRYPTION_KEY=

POSTGRES_DB=shell
POSTGRES_USER=shell
POSTGRES_PASSWORD=

# Tilbot's database (MongoDB): its administrator, and Tilbot's own login. Set once, when the database is made.
MONGO_ROOT_PASSWORD=
MONGO_TILBOT_PASSWORD=

# Only for a language model by API key in project/compose.yaml (its example shows how).
# OPENAI_API_KEY=
# OPENAI_MODEL=
# Only for project/narrative.toml with a model by API key (server = "openai").
# MODEL_API_KEY=
# This computer's language model instead of the one in project/narrative.toml, for example a small one on a
# laptop and a large one on the server. Empty: narrative.toml's model.
# NARRATIVE_MODEL=
