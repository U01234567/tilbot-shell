# Copy to .env and fill in. Never commit .env.
# `python start_shell.py secrets` prints fresh values for every secret below.

SHELL_ENV=development        # development or production
SHELL_HOST=localhost         # where participants open the shell
BOT_HOST=bot.localhost       # where the Tilbot chat is served (inside an iframe)
# INTENT_MODEL=                # sentence-transformers model for phase 3; default: a Dutch one (compose.yaml)

DJANGO_SECRET_KEY=
BRIDGE_SECRET=               # also the value of parameter bridge_secret in Tilbot's Processing blocks
TILBOT_SESSION_SECRET=

# Without this key the stored answers cannot be read. Back it up apart from the database
# (docs/operations.md). Never change it once real data is stored.
FIELD_ENCRYPTION_KEY=

POSTGRES_DB=shell
POSTGRES_USER=shell
POSTGRES_PASSWORD=
