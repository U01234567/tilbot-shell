+  // A line of its own like [[line Much pain|No pain|67|75|worth]] is drawn as a small line with a dot
+  // (tilbot-shell, patch 0011): the words at its left (worse) and right (better) end, the dot's place and the
+  // threshold's place from 0 to 100 (empty: none), and fine, worth or neutral. As text, no HTML.
+  const CHART_LINE = /^\[\[line ([^\]\n]*)\]\]$/m;
+
+  type ChartLine = { left: string; right: string; at: number; limit: number | null; state: string };
+
+  function chartsAndText(content: string): Array<string | ChartLine> {
+    return content.split(CHART_LINE).map((piece, i) => {
+      if (i % 2 === 0) {
+        return piece.replace(/^\n|\n$/g, ""); // the line breaks around a chart are the chart's own
+      }
+      const [left = "", right = "", at = "0", limit = "", state = "neutral"] = piece.split("|");
+      return { left, right, at: Number(at), limit: limit === "" ? null : Number(limit), state };
+    });
+  }
