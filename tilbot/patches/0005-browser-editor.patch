diff --git a/frontend/src/lib/utils/serverEditorApi.ts b/frontend/src/lib/utils/serverEditorApi.ts
new file mode 100644
index 0000000..3209304
--- /dev/null
+++ b/frontend/src/lib/utils/serverEditorApi.ts
@@ -0,0 +1,100 @@
+import { readSheet } from "read-excel-file/browser";
+
+// The editor talks to the desktop app through window.api (app/preload.js). In a browser, this
+// object takes its place: the same actions, for one project stored on the server.
+export function serverEditorApi(projectId: string) {
+  const actions: Record<string, (data: any) => unknown> = {
+    "load-project": () => request(`/api/editor_project?projectid=${projectId}`),
+    "save-project": async (project) => {
+      await request(
+        "/api/editor_project",
+        postJson({ projectid: projectId, project })
+      );
+      return true;
+    },
+    "load-settings": () => ({
+      generalSettings: {},
+      path: `${location.origin}/proj_pub/${projectId}`,
+    }),
+    // General settings are empty (common/project/types.ts); the dashboard keeps the LLM settings.
+    "save-settings": () => undefined,
+    // The desktop app does nothing with this either: the simulator reads data through window.api.
+    "load-project-db": () => undefined,
+    // The file stays on the server: the saved project, and a running chat, may still use it.
+    "do-delete-avatar": () => undefined,
+    "load-excel": async () => {
+      const file = await pickFile(".xlsx");
+      return file === null ? null : await readSheet(file);
+    },
+    "load-avatar": async () => {
+      const file = await pickFile(".png,.jpg,.jpeg,.svg");
+      if (file === null) {
+        return null;
+      }
+      const form = new FormData();
+      form.append("projectid", projectId);
+      form.append("file", file); // last: the server reads the fields that come before the file
+      const reply = await request("/api/editor_avatar", {
+        method: "POST",
+        body: form,
+      });
+      return reply.filename;
+    },
+  };
+
+  // Every other channel is a data-table action; the server refuses names it doesn't know.
+  async function invoke(channel: string, data?: any) {
+    if (Object.hasOwn(actions, channel)) {
+      return await actions[channel](data);
+    }
+    const reply = await request(
+      "/api/editor_variables",
+      postJson({ projectid: projectId, channel, data })
+    );
+    return reply.result;
+  }
+
+  return { invoke, send: invoke };
+}
+
+function postJson(body: object): RequestInit {
+  return {
+    method: "POST",
+    headers: { "Content-Type": "application/json" },
+    body: JSON.stringify(body),
+  };
+}
+
+// Tilbot's server refuses a request with status 200 and a short code, such as NOT_LOGGED_IN.
+// The extra header tells the server the request comes from the editor (see ownProject there).
+async function request(url: string, init: RequestInit = {}): Promise<any> {
+  const response = await fetch(url, {
+    ...init,
+    headers: { ...init.headers, "X-Tilbot-Editor": "1" },
+  });
+  const isJson = response.headers
+    .get("Content-Type")
+    ?.startsWith("application/json");
+  const body = isJson ? await response.json() : await response.text();
+  if (!response.ok || !(isJson || body === "OK")) {
+    const message =
+      `The Tilbot server refused this (${body || response.status}). ` +
+      "Your changes are still in this tab. If you were logged out, log in again in another tab and retry.";
+    alert(message);
+    throw new Error(message);
+  }
+  return body;
+}
+
+// The chosen file, or null when the dialog is closed without one, as in the desktop app.
+function pickFile(accept: string): Promise<File | null> {
+  const input = Object.assign(document.createElement("input"), {
+    type: "file",
+    accept,
+  });
+  return new Promise((resolve) => {
+    input.addEventListener("change", () => resolve(input.files?.[0] ?? null));
+    input.addEventListener("cancel", () => resolve(null));
+    input.click();
+  });
+}
