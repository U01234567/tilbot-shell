+/*
+ * The editor in a browser. It sends the same actions as the desktop app (app/electron-main.ts),
+ * for a project stored on this server, owned by the user who is logged in.
+ */
+const EDITOR_BODY_LIMIT = 20 * 1024 * 1024; // bytes; a data table imported from Excel can be large
+const AVATAR_FILE = /\.(png|jpe?g|svg)$/i; // the same types the desktop app accepts
+
+// A logged-in user, and for a change (POST) the editor's own header: another site can't add that
+// header without a CORS preflight, which this server refuses, so a forged form never passes.
+function requireEditorUser(req: FastifyRequest): string {
+  const session: any = req.session;
+  if (session.username == undefined) {
+    throw new TilBotNotLoggedInError();
+  }
+  if (req.method === "POST" && req.headers["x-tilbot-editor"] !== "1") {
+    throw new TilBotError();
+  }
+  return session.username;
+}
+
+// The project must belong to the user; its id is checked before it names a folder on disk.
+async function ownProject(req: FastifyRequest, projectId: unknown) {
+  const username = requireEditorUser(req);
+  if (typeof projectId !== "string" || !/^[0-9a-f]{32}$/.test(projectId)) {
+    throw new TilBotProjectNotFoundError(String(projectId));
+  }
+  return await ProjectModel.getById(projectId, { user_id: username, active: true });
+}
+
+// The project's data tables. A running chat opens the same file, so it is created if missing.
+function openVariables(projectId: string): VariableDb {
+  const dir = `${__dirname}/projects/${projectId}`;
+  mkdirSync(dir, { recursive: true });
+  return new VariableDb(`${dir}/variables.db`);
+}
+
+app.get("/api/editor_project", async (req, res) => {
+  const query: any = req.query;
+  const project = await ownProject(req, query.projectid);
+  return project.toModel();
+});
+
+app.post(
+  "/api/editor_project",
+  { bodyLimit: EDITOR_BODY_LIMIT },
+  async (req, res) => {
+    const body: any = req.body;
+    const project = await ownProject(req, body.projectid);
+    if (!(body.project?.settings instanceof Object)) {
+      throw new TilBotError();
+    }
+    project.fromModel(body.project);
+    await project.save();
+  }
+);
+
+const VARIABLE_ACTIONS: Record<string, (db: VariableDb, data: any) => unknown> =
+  {
+    "get-data-table": (db, tableName) => db.getTable(tableName),
+    "get-data-table-cols": (db, tableName) => db.getColNames(tableName),
+    "get-data-table-column": (db, data) =>
+      db.getColumn(data.tableName, data.columnName, data.filterCol, data.filterVal),
+    "get-data-table-cell": (db, data) =>
+      db.getCell(data.tableName, data.columnName, data.val),
+    "get-data-table-random-row": (db, data) => db.getRandomRow(data.tableName),
+    "save-variable": (db, data) => {
+      db.delete(data.prevVariablename);
+      db.save(data.name, data.data);
+      return true;
+    },
+  };
+
+app.post(
+  "/api/editor_variables",
+  { bodyLimit: EDITOR_BODY_LIMIT },
+  async (req, res) => {
+    const body: any = req.body;
+    if (!Object.hasOwn(VARIABLE_ACTIONS, body.channel)) {
+      throw new TilBotError();
+    }
+    const action = VARIABLE_ACTIONS[body.channel];
+    const project = await ownProject(req, body.projectid);
+    const db = openVariables(project.id);
+    try {
+      // Wrapped, so a null result is still a JSON reply, never text the editor reads as a refusal.
+      return { result: action(db, body.data) };
+    } finally {
+      db.close();
+    }
+  }
+);
+
+// An earlier avatar is not deleted: the saved project, and a running chat, may still use it.
+app.post("/api/editor_avatar", async (req, res) => {
+  const data = await req.file();
+  const project = await ownProject(
+    req,
+    (data?.fields.projectid as MultipartValue)?.value
+  );
+  const filename = basename(data!.filename);
+  if (!AVATAR_FILE.test(filename)) {
+    throw new TilBotError();
+  }
+
+  const dir = `${__dirname}/proj_pub/${project.id}/avatar`;
+  mkdirSync(dir, { recursive: true });
+  writeFileSync(`${dir}/${filename}`, await data!.toBuffer());
+  return { filename };
+});
+
+// The project as a .tilbot file, the same format the desktop app saves and the import above reads.
+app.get("/api/export_project", async (req, res) => {
+  const query: any = req.query;
+  const project = await ownProject(req, query.projectid);
+
+  const zip = new AdmZip();
+  zip.addFile("project.json", Buffer.from(JSON.stringify(project.toModel())));
+  openVariables(project.id).close(); // so variables.db exists even if no data table was ever saved
+  zip.addLocalFile(`${__dirname}/projects/${project.id}/variables.db`);
+  for (const avatar of [project.settings.avatar_file, project.settings.avatar_file_sm]) {
+    if (avatar) {
+      zip.addLocalFile(`${__dirname}/proj_pub/${project.id}/avatar/${basename(avatar)}`, "avatar");
+    }
+  }
+
+  const filename = String(project.settings.project_name).replace(/[^\w -]/g, "_");
+  res.header("Content-Type", "application/zip");
+  res.header("Content-Disposition", `attachment; filename="${filename}.tilbot"`);
+  return zip.toBuffer();
+});
+
