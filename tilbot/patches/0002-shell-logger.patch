+// Conversation events go to SHELL_LOG_URL when it is set, otherwise to MongoDB if the project logs.
+function chooseLogger(
+  project: any,
+  projectId: string,
+  participantId: string
+): ProjectControllerLoggerInterface {
+  if (process.env.SHELL_LOG_URL) {
+    return new ShellLogger(process.env.SHELL_LOG_URL, process.env.BRIDGE_SECRET ?? "", participantId);
+  }
+  return project.settings.logging_enabled ? new Logger(projectId) : new NonLogger();
+}
