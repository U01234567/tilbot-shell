+// Conversation events go to the embedding site when SHELL_URL is set, otherwise to MongoDB if the project logs.
+function chooseLogger(
+  project: any,
+  projectId: string,
+  participantId: string
+): ProjectControllerLoggerInterface {
+  if (process.env.SHELL_URL) {
+    return new ShellLogger(process.env.SHELL_URL + "log", process.env.BRIDGE_SECRET ?? "", participantId);
+  }
+  return project.settings.logging_enabled ? new Logger(projectId) : new NonLogger();
+}
