new file mode 100644
index 0000000..bab85a3
--- /dev/null
+++ b/backend/shelllogger.ts
@@ -0,0 +1,50 @@
+import { randomUUID } from "crypto";
+import type { ProjectControllerLoggerInterface } from "../common/projectcontroller/types.ts";
+
+/**
+ * Sends every conversation event to an external server (for example a site that embeds Tilbot)
+ * instead of storing it in MongoDB. Used when SHELL_LOG_URL is set.
+ *
+ * Events are posted as form fields: participant_id, conversation, seq (order within the
+ * conversation), event, detail and bridge_secret (from BRIDGE_SECRET).
+ */
+export class ShellLogger implements ProjectControllerLoggerInterface {
+  private readonly url: string;
+  private readonly secret: string;
+  private readonly conversation: string = randomUUID();
+  private participantId: string;
+  private seq: number = 0;
+
+  constructor(url: string, secret: string, participantId: string) {
+    this.url = url;
+    this.secret = secret;
+    this.participantId = participantId;
+  }
+
+  log(event: string, detail = ""): void {
+    const data = new FormData();
+    data.append("participant_id", this.participantId);
+    data.append("conversation", this.conversation);
+    data.append("seq", String(this.seq++));
+    data.append("event", event);
+    data.append("detail", detail);
+    data.append("bridge_secret", this.secret);
+
+    fetch(this.url, { method: "POST", body: data })
+      .then((res) => {
+        if (!res.ok) {
+          console.error(`ShellLogger: event '${event}' rejected with ${res.status}`);
+        }
+      })
+      .catch((error) => console.error(`ShellLogger: event '${event}' not delivered`, error));
+  }
+
+  set_participant_id(pid: string): void {
+    this.participantId = pid;
+  }
+
+  async log_audio(audio: Blob): Promise<void> {
+    // Refuse loudly rather than drop the recording silently.
+    throw new Error("ShellLogger does not store audio");
+  }
+}
